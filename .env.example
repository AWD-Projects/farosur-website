NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com
# NEXT_PUBLIC_GSC_VERIFICATION=

# Cotizador del catálogo (Resend). El remitente requiere un dominio verificado en Resend.
RESEND_API_KEY=
QUOTE_TO_EMAIL=correo-de-faro-sur@ejemplo.com   # varios destinatarios separados por coma
QUOTE_FROM_EMAIL=catalogo@tu-dominio.com
# Solo para pruebas: simula el envío sin llamar a Resend
# QUOTE_DRY_RUN=1

# Firebase (proyecto faro-sur-app). Plan Spark: las fotos se guardan en Firestore, sin Cloud Storage.
# La config web es pública y ya tiene valores por defecto en src/lib/firebase/config.ts.
# Cuenta de servicio: Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar clave privada
FIREBASE_PROJECT_ID=faro-sur-app
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Token provisional para /api/upload hasta que exista el panel con inicio de sesión
ADMIN_UPLOAD_TOKEN=
